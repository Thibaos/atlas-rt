#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

#include "common/header.glsl"
#include "common/bindings.glsl"
#include "common/raygen_common.glsl"
#include "common/sky.glsl"
#include "common/sampling.glsl"

const float PI = 3.14159265359;
const float AO_ORIGIN_OFFSET = 1e-3;
const float SHADOWED_ALBEDO_SCALE = 0.25;

layout(location = 0) rayPayloadEXT MainPassPayload payload;
layout(location = 1) rayPayloadEXT MainPassPayload shadow_payload;
layout(location = 2) rayPayloadEXT OcclusionPayload occlusion;

void reset_payload() {
    payload.t = FLT_MAX;
    payload.color = vec4(0.0);
    payload.normal = vec3(0.0);

    shadow_payload.t = FLT_MAX;
    shadow_payload.color = vec4(0.0);
    shadow_payload.normal = vec3(0.0);
}

#define VOXEL_SBT_INDEX 0u
#define SHADOW_SBT_INDEX 1u
#define RETRACE_SBT_INDEX 2u
#define HULL_SBT_INDEX 3u

vec3 cosine_hemisphere(vec2 point, vec3 normal, vec3 tangent, vec3 bitangent) {
    float r = sqrt(point.x);
    float phi = 2.0 * PI * point.y;
    float z = sqrt(1.0 - point.x);

    return tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) + normal * z;
}

vec3 sky_ambient(vec3 sample_origin, vec3 normal) {
    vec3 tangent;
    vec3 bitangent;
    orthonormal_basis(normal, tangent, bitangent);

    vec2 shift = pixel_shift(gl_LaunchIDEXT.xy);
    vec3 floor_radiance = scene.ao_floor * sky_radiance(normal);
    vec3 ambient = vec3(0.0);

    for (uint i = 0u; i < scene.ao_samples; ++i) {
        vec3 sample_direction = cosine_hemisphere(fract(r2_point(i) + shift), normal, tangent, bitangent);

        if (dot(sample_direction, normal) <= 0.0) {
            continue;
        }

        occlusion.visible = 1.0;

        traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), gl_RayFlagsOpaqueEXT, 0xFFu, SHADOW_SBT_INDEX, 0u, 0u, sample_origin, RAY_T_MIN, sample_direction, scene.ao_radius, 2);

        ambient += (occlusion.visible > 0.5) ? sky_radiance(sample_direction) : floor_radiance;
    }

    return ambient / float(scene.ao_samples);
}

void assume_miss(vec3 direction) {
    payload.color = vec4(sky_radiance(direction), 1.0);
    payload.alpha = 1.0;
}

void shade_hit(vec3 origin, vec3 direction) {
    if (payload.t >= FLT_MAX) {
        return;
    }

    vec3 albedo = payload.color.rgb;
    vec3 sun_direction = normalize(vec3(-0.5, -0.8, 0.5));
    vec3 hit_position = origin + (payload.t - EPSILON) * direction;

    shadow_payload.t = FLT_MAX;
    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), gl_RayFlagsOpaqueEXT, 0xFFu, SHADOW_SBT_INDEX, 0u, 0u, hit_position, RAY_T_MIN, -sun_direction, RAY_T_MAX, 1);

    bool sun_visible = shadow_payload.t >= FLT_MAX;

    if (scene.ao_samples == 0u) {
        if (!sun_visible) {
            payload.color.rgb *= SHADOWED_ALBEDO_SCALE;
        }

        return;
    }

    vec3 normal = payload.normal;
    vec3 sample_origin = hit_position + normal * AO_ORIGIN_OFFSET;

    payload.color.rgb = albedo * (float(sun_visible) + sky_ambient(sample_origin, normal));
}

void main() {
    vec3 origin;
    vec3 direction;
    build_primary_ray(origin, direction);

    reset_payload();
    assume_miss(direction);

    uint sbt_offset = (mode == MODE_HULL) ? HULL_SBT_INDEX : VOXEL_SBT_INDEX;

    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), gl_RayFlagsOpaqueEXT, 0xFFu, sbt_offset, 0u, 0u, origin, RAY_T_MIN, direction, RAY_T_MAX, 0);

    if (mode == MODE_NORMAL) {
        imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), vec4(payload.normal * 0.5 + 0.5, 1.0));
        return;
    }

    if (mode == MODE_HULL) {
        imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
        return;
    }

    shade_hit(origin, direction);

    if (mode == MODE_VOXEL && payload.alpha > 0.0 && payload.alpha < 1.0) {
        float coverage = payload.alpha;
        vec4 stashed_color = payload.color;
        float stashed_t = payload.t;

        reset_payload();
        assume_miss(direction);

        traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), gl_RayFlagsOpaqueEXT, 0xFFu, RETRACE_SBT_INDEX, 0u, 0u, origin, stashed_t, direction, RAY_T_MAX, 0);

        shade_hit(origin, direction);

        payload.color.rgb = stashed_color.rgb * coverage + payload.color.rgb * (1.0 - coverage);
    }

    imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
}
